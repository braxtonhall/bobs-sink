{
	"name": "@bobs-sink/client",
	"version": "0.1.0",
	"description": "Browser client for bobs-sink: passkey identity, device keys, and Yjs sync",
	"license": "MIT",
	"keywords": [
		"bobs-sink",
		"yjs",
		"crdt",
		"passkeys",
		"sync"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/braxtonhall/bobs-sink.git",
		"directory": "packages/client"
	},
	"homepage": "https://github.com/braxtonhall/bobs-sink/tree/main/packages/client#readme",
	"bugs": "https://github.com/braxtonhall/bobs-sink/issues",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"typecheck": "tsc --noEmit && tsc --noEmit -p test",
		"prepublishOnly": "tsc -b tsconfig.build.json --clean && tsc -b tsconfig.build.json"
	},
	"dependencies": {
		"@bobs-sink/protocol": "0.1.0",
		"@simplewebauthn/browser": "^14.0.0",
		"lib0": "^0.2.119",
		"y-indexeddb": "^9.0.12",
		"y-protocols": "^1.0.7"
	},
	"peerDependencies": {
		"yjs": "^13.6.0"
	},
	"devDependencies": {
		"@bobs-sink/server": "0.1.0",
		"@bobs-sink/test-support": "0.1.0",
		"fake-indexeddb": "^6.2.6",
		"yjs": "^13.6.33"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
