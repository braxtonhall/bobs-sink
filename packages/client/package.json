	},
	"peerDependencies": {
		"yjs": "^13.6.0"
	},
	"devDependencies": {
		"@bobs-sink/server": "0.1.0",
		"@bobs-sink/test-support": "0.1.0",
		"fake-indexeddb": "^6.2.6",
		"yjs": "^13.6.33"
