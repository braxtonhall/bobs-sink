# All variables are optional; defaults are shown.
PORT=8080
HOST=0.0.0.0
DATABASE_PATH=./data/sink.sqlite
# JSON file with registered app policies (see README).
APPS_FILE=
# Set when running behind a reverse proxy that sets X-Forwarded-For (e.g. Caddy).
TRUST_PROXY=false
# Accept http://localhost origins with RP ID "localhost" (development only).
ALLOW_LOCALHOST=false
# Enables /admin routes when set.
ADMIN_TOKEN=
LOG_LEVEL=info
