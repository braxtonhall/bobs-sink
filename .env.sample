# All variables are optional; defaults are shown.
PORT=8080
HOST=0.0.0.0
DATABASE_PATH=./data/sink.sqlite
# Set when running behind a reverse proxy that sets X-Forwarded-For (e.g. Caddy).
TRUST_PROXY=false
# Accept http://localhost origins with RP ID "localhost" (development only).
ALLOW_LOCALHOST=false
# Enables /admin routes when set.
ADMIN_TOKEN=
LOG_LEVEL=info

# The operator console (/operator). Set all of these or none.
# The service's own origin, with no trailing slash.
PUBLIC_URL=
# bobs-server's SSO page, e.g. https://bobs-server.net/sso
SSO_URL=
# bobs-server's code exchange over the internal network, e.g. http://server/api/sso/exchange
SSO_EXCHANGE_URL=
# Shared with bobs-server.
SSO_EXCHANGE_SECRET=
# Comma-separated; compared case-insensitively.
OPERATOR_EMAILS=
