{
	"name": "bobs-sink",
	"version": "0.1.0",
	"private": true,
	"description": "A small, self-hostable CRDT document service and its browser client",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"packages/protocol",
		"packages/test-support",
		"packages/server",
		"packages/client",
		"packages/demo"
	],
	"scripts": {
		"build": "tsc -b packages/server/tsconfig.build.json packages/client/tsconfig.build.json",
		"dev": "npm run dev -w @bobs-sink/server",
		"start": "npm start -w @bobs-sink/server",
		"typecheck": "tsc --noEmit && npm run typecheck --workspaces",
		"lint": "eslint .",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"demo": "npm run dev -w @bobs-sink/demo"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true
	}
}
